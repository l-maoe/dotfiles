{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch3",
        "height": 20,
    },
    "display": {
        "separator": " ⇾ "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "key": "≽(•⩊ •マ≼",
        },
        {
            "type": "custom",
            "format": "┌───────────────────────────────────────────────────────┐",
            "outputColor": "5"
        },
        {
            "type": "os",
            "key": "   OS",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "   Packages",
            "keyColor": "38;5;230"
        },
        {
            "type": "wm",
            "key": "   WM",
            "keyColor": "38;5;219"
        },
        {
            "type": "de",
            "key": "    DE",
            "keyColor": "38;5;219"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "keyColor": "38;5;219"
        },
        {
            "type": "command",
            "key": "  ⧖ OS Age ",
            "keyColor": "38;5;165",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  󱫐 Uptime ",
            "keyColor": "38;5;165"
        },
        {
            "type": "custom",
            "format": "└───────────────────────────────────────────────────────┘",
            "outputColor": "5"
        },
        "break",
        {
            "type": "custom",
            "format": "ᓚ₍⑅^..^₎♡ Hardware",
            "outputColor": "36;1"
        },
        {
            "type": "custom",
            "format": "┌───────────────────────────────────────────────────────┐",
            "outputColor": "5"
        },
        {
            "type": "host",
            "key": "  ☼ Host",
            "keyColor": "36"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "   CPU",
            "keyColor": "36"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": "   GPU",
            "keyColor": "38;5;230"
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": "   GPU Driver",
            "keyColor": "38;5;230"
        },
        {
            "type": "display",
            "key": "   Display",
            "keyColor": "38;5;219"
        },
        {
             "type": "memory",
            "key": "  ﬙ Memory",
            "keyColor": "38;5;165"
        },
        {
            "type": "disk",
            "key": "  ✎ Disk",
            "keyColor": "38;5;165"
        },
        {
            "type": "custom",
            "format": "└───────────────────────────────────────────────────────┘",
            "outputColor": "5"
        },
	{
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },
        "break"
        
    ]
}
